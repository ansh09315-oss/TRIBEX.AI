# ==============================================================================
# TribeX AI — Master Environment Configuration Template (.env.example)
# Copy to .env and configure for local or cloud environments
# ==============================================================================

# --- Application Core ---
ENVIRONMENT=development
PROJECT_NAME="TribeX AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
DEBUG=True

# --- Security & JWT Authentication ---
SECRET_KEY="generate_a_64_character_hex_secret_key_here_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURITY_SALT_PEPPER="tribex_mota_secure_salt_pepper_2026_prod"

# --- Frontend Client Environment (Vite / Vercel) ---
VITE_API_URL="http://localhost:8000/api/v1"
VITE_APP_ENV="development"
VITE_ENABLE_MOCK_BLE="true"
VITE_ENABLE_PWA="true"

# --- PostgreSQL Database Configuration ---
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="tribex_admin"
POSTGRES_PASSWORD="tribex_secure_pass_2026"
POSTGRES_DB="tribex_db"
DATABASE_URL="postgresql+asyncpg://tribex_admin:tribex_secure_pass_2026@localhost:5432/tribex_db"

# --- Redis Caching & Queue State ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# --- MinIO / AWS S3 Object Storage (AES-256 Encrypted) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio_tribex_admin"
S3_SECRET_KEY="minio_tribex_secure_password_2026"
S3_BUCKET_NAME="tribex-encrypted-vault"
S3_REGION="ap-south-1"
S3_SECURE=false

# --- AI Models & Speech Processing (Whisper / EasyOCR / Bhashini) ---
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
EASYOCR_LANGUAGES="en,hi"
BHASHINI_API_KEY="optional_bhashini_meity_api_key_here"
BHASHINI_PIPELINE_ENDPOINT="https://dhruva-api.bhashini.gov.in/services/inference/pipeline"

# --- Zero-Knowledge Cryptographic Trust Layer (Groth16 / BN254) ---
ZKP_CIRCUIT_PATH="backend/app/zkp/circuits/MoTA_IncomeTribe_v2.r1cs"
ZKP_VERIFICATION_KEY_PATH="backend/app/zkp/keys/verification_key.json"
ZKP_MERKLE_TREE_DEPTH=16

# --- Inter-Ministerial De-Duplication Federation Endpoints ---
AICTE_REGISTRY_ENDPOINT="https://mock-aicte.tribex.gov.in/api/v1/scholarships"
UGC_REGISTRY_ENDPOINT="https://mock-ugc.tribex.gov.in/api/v1/scholarships"
STATE_PORTAL_REGISTRY_ENDPOINT="https://mock-state.tribex.gov.in/api/v1/tribal-claims"
